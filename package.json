{
  "name": "margo-ui",
  "version": "1.2.3",
  "description": "A small React UI kit built on Tailwind CSS v4 design tokens, themeable through plain CSS custom properties.",
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "design-system",
    "typescript"
  ],
  "license": "MIT",
  "author": "Roberto Attanasio",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "margo.css",
    "css.d.ts"
  ],
  "workspaces": [
    "."
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./css": "./margo.css",
    "./fonts/*": "./src/fonts/*"
  },
  "scripts": {
    "ts:check": "tsc --noEmit",
    "changeset:add": "changeset",
    "changeset:bump": "changeset version",
    "build:release": "npm run ts:check && npm pack && changeset publish && git push --follow-tags"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-renderable": "^1.0.4",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
