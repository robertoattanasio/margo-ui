{
  "name": "margo-ui",
  "version": "0.1.0",
  "description": "A small React UI kit built on Tailwind CSS v4 design tokens, themeable through plain CSS custom properties.",
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "design-system",
    "typescript"
  ],
  "license": "MIT",
  "author": "Roberto Attanasio",
  "homepage": "https://github.com/robertoattanasio/margo-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertoattanasio/margo-ui.git"
  },
  "bugs": {
    "url": "https://github.com/robertoattanasio/margo-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./css": "./src/css/margo.css",
    "./fonts.css": "./src/fonts/fonts.css",
    "./fonts/*": "./src/fonts/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-renderable": "^1.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
