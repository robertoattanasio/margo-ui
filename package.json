{
  "name": "margo-ui",
  "version": "6.2.0",
  "description": "margo-ui is a React component kit in plain CSS, with compound components and styles your own classes always override.",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "typescript",
    "css"
  ],
  "license": "MIT",
  "author": "Roberto Attanasio",
  "homepage": "https://dev.robertoattanasio.com/margo-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertoattanasio/margo-ui.git"
  },
  "bugs": {
    "url": "https://github.com/robertoattanasio/margo-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "margo.css"
  ],
  "workspaces": [
    "."
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./margo.css"
  },
  "scripts": {
    "ts:check": "tsc --noEmit",
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "rm -rf dist && tsc",
    "changeset:add": "changeset",
    "changeset:bump": "changeset version",
    "build:release": "npm run ts:check && npm run build && npm pack && changeset publish && git push --follow-tags"
  },
  "dependencies": {
    "react-icons": "^5.7.0",
    "react-renderable": "^1.0.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
